{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:faceponto:sync-response:v1",
  "title": "Recibos individuais de ingestão",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "server_timestamp", "results"],
  "properties": {
    "protocol_version": { "const": 1 },
    "server_timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "results": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/accepted" },
          { "$ref": "#/$defs/quarantined" },
          { "$ref": "#/$defs/rejected" },
          { "$ref": "#/$defs/retry" }
        ]
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f-]{36}$" },
    "accepted": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "receipt_id", "punch_type"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "status": { "enum": ["accepted", "already_received"] },
        "receipt_id": { "$ref": "#/$defs/uuid" },
        "punch_type": { "enum": ["unclassified", "entry", "break_start", "break_end", "exit"] }
      }
    },
    "quarantined": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "receipt_id", "code"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "status": { "const": "quarantined" },
        "receipt_id": { "$ref": "#/$defs/uuid" },
        "code": { "enum": ["CLOCK_UNVERIFIED", "CLOCK_INCONSISTENCY", "AUTHORIZATION_CHANGED", "SUSPICIOUS_PROXIMITY"] }
      }
    },
    "rejected": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "code"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "status": { "const": "rejected" },
        "code": { "enum": ["IDEMPOTENCY_CONFLICT", "EMPLOYEE_NOT_AUTHORIZED", "INVALID_ASSIGNMENT", "INVALID_RECOGNITION_EVIDENCE", "INVALID_CLOCK_ANCHOR"] }
      }
    },
    "retry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "retry_after_seconds"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "status": { "const": "retry" },
        "retry_after_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    }
  }
}
